<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="appointment_type_view_form" model="ir.ui.view">
        <field name="name">agendame.type.view.form</field>
        <field name="model">agendame.type</field>
        <field name="arch" type="xml">
            <form string="Tipo de Cita">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Ej: Llamada de Ventas"/></h1>
                        <div name="options" groups="base.group_user">
                            <span class="d-inline-block">
                                <i class="fa fa-link"/> <field name="booking_url" widget="url" readonly="1" class="ms-1"/>
                            </span>
                        </div>
                    </div>
                    <group>
                        <group>
                            <field name="image_1920" widget="image" class="oe_avatar"/>
                            <field name="appointment_duration" widget="float_time"/>
                            <field name="appointment_tz"/>
                            <field name="event_videocall_source"/>
                            <field name="max_schedule_days"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="color_primary" widget="color"/>
                            <field name="color_secondary" widget="color"/>
                            <field name="staff_user_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Horarios Disponibles" name="slots">
                            <field name="slot_ids">
                                <list editable="bottom">
                                    <field name="weekday"/>
                                    <field name="start_hour" widget="float_time"/>
                                    <field name="end_hour" widget="float_time"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
            </form>
        </field>
    </record>

    <record id="appointment_type_view_list" model="ir.ui.view">
        <field name="name">agendame.type.view.list</field>
        <field name="model">agendame.type</field>
        <field name="arch" type="xml">
            <list string="Tipos de Cita">
                <field name="name"/>
                <field name="appointment_duration" widget="float_time"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="appointment_type_action" model="ir.actions.act_window">
        <field name="name">Tipos de Cita</field>
        <field name="res_model">agendame.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Appointment menus integrated into the native Calendar app (complement, not standalone application) -->
    <menuitem id="menu_appointment_root" name="Citas" parent="calendar.mail_menu_calendar" sequence="20"/>
    <menuitem id="menu_appointment_type_action" name="Tipos de Cita" parent="menu_appointment_root" action="appointment_type_action" sequence="10"/>
</odoo>
