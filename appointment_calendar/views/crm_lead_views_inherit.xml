<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="crm_lead_view_form_inherit_appointment_calendar" model="ir.ui.view">
        <field name="name">crm.lead.view.form.inherit.appointment_calendar</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_send_appointment_link" 
                        string="Enviar Enlace de Cita" 
                        type="object" 
                        class="oe_highlight"
                        attrs="{'invisible': [('appointment_type_id', '=', False)]}"/>
            </xpath>
            <xpath expr="//group[@name='lead_info']" position="inside">
                <group string="Reserva de Cita">
                    <field name="appointment_type_id" options="{'no_create': True}"/>
                    <field name="booking_link" widget="url" attrs="{'invisible': [('appointment_type_id', '=', False)]}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
