<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!--
        Regular internal users (base.group_user) see only appointment types
        where they are listed as staff. System admins (base.group_system)
        see every type.
        -->
        <record id="rule_appointment_type_own" model="ir.rule">
            <field name="name">Appointment Type: own agendas only</field>
            <field name="model_id" ref="model_appointment_calendar_type"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">
                [("staff_user_ids", "in", user.id)]
            </field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_appointment_type_admin" model="ir.rule">
            <field name="name">Appointment Type: admin full access</field>
            <field name="model_id" ref="model_appointment_calendar_type"/>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="domain_force">[(1, "=", 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Slots follow the parent appointment type ownership. -->
        <record id="rule_appointment_slot_own" model="ir.rule">
            <field name="name">Appointment Slot: own type slots only</field>
            <field name="model_id" ref="model_appointment_calendar_slot"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">
                [("appointment_type_id.staff_user_ids", "in", user.id)]
            </field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_appointment_slot_admin" model="ir.rule">
            <field name="name">Appointment Slot: admin full access</field>
            <field name="model_id" ref="model_appointment_calendar_slot"/>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="domain_force">[(1, "=", 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>
